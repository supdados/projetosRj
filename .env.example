# ProjetosRJ — exemplo de variáveis de ambiente.
# Copie para `.env` e preencha. NUNCA versione o `.env` real (já está no .gitignore).
# PT: valores abaixo são apenas placeholders. EN: values below are placeholders only.
#
# Instalação local: `python scripts/dev/setup_local.py` gera o `.env` sozinho a
# partir deste arquivo (SECRET_KEY aleatória, cookie sem HTTPS e TODAS as
# integrações desligadas). Local install: the script above writes `.env` for you.

# ══ MÍNIMO PARA RODAR / MINIMUM TO RUN ═══════════════════════════════════════

# [OBRIGATÓRIA] Chave de assinatura de sessão/CSRF. Gere uma aleatória forte:
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Modo debug do Flask. 0 em produção; 1 só em dev local.
FLASK_DEBUG=0
# Cookie de sessão só por HTTPS. Mantenha 1 em produção. Em dev por
# http://<IP> use 0, senão o login entra em loop (http://localhost funciona com 1).
SESSION_COOKIE_SECURE=1
# Endereço do `python app.py` (só dev; produção sobe por gunicorn).
# 127.0.0.1 = só esta máquina. 0.0.0.0 expõe na rede — com FLASK_DEBUG=1 o
# debugger permite executar código, então só use 0.0.0.0 com debug desligado.
APP_HOST=127.0.0.1
APP_PORT=5002

# ── Banco de dados / Database ────────────────────────────────────────────────
# Tudo vazio = SQLite em instance/projetosrj.db (padrão para dev; a pasta é
# criada sozinha). Produção usa MySQL 8 via PyMySQL.
# Opção A: URL completa (tem precedência). Ex.: mysql+pymysql://user:pass@host:3306/dbname
DATABASE_URL=
# Opção B: partes separadas (usadas se DATABASE_URL estiver vazia; host = localhost).
DB_USER=
DB_PASSWORD=
DB_NAME=

# ══ INTEGRAÇÕES OPCIONAIS / OPTIONAL INTEGRATIONS ════════════════════════════
# O app funciona completo sem nenhuma delas (login local com usuário e senha).
# Cada uma tem um liga/desliga `*_ENABLED`; ligada sem credencial = fica
# desligada e o boot loga um aviso. O resumo aparece no log ao subir:
#   "Integrações: Gov.br=OFF · Google Calendar=OFF · watsonx=OFF · ..."

# ── [OPCIONAL] Login Gov.br (OpenID Connect) ─────────────────────────────────
# Exige cliente cadastrado no Gov.br (credencial de órgão).
GOVBR_OIDC_ENABLED=0
GOVBR_OIDC_BASE_URL=
GOVBR_OIDC_REALM=
GOVBR_OIDC_CLIENT_ID=
GOVBR_OIDC_CLIENT_SECRET=
GOVBR_OIDC_REDIRECT_URI=
# redirect_uri EXPLÍCITO do ambiente (recomendado em produção/staging): quando
# preenchido é enviado literal ao IdP, sem derivar nada do Host do request.
# Deve bater EXATAMENTE com uma das URIs registradas no cliente gov.br.
# Vazio = mantém a derivação por request (comportamento legado, ok em dev local).
# DEPLOY: validar em staging atrás do proxy real antes de produção.
GOVBR_OIDC_REDIRECT_URI_FIXED=
GOVBR_OIDC_POST_LOGOUT_REDIRECT_URI=
GOVBR_OIDC_SCOPE=openid profile email

# ── [OPCIONAL] Google Calendar ───────────────────────────────────────────────
# Sem o arquivo de credenciais a integração fica desligada mesmo com 1.
GOOGLE_CALENDAR_ENABLED=0
# Caminho para o JSON de credenciais OAuth (NUNCA commitar esse arquivo).
GOOGLE_CALENDAR_CLIENT_SECRET_FILE=config/client_secret.json
GOOGLE_CALENDAR_PUBLIC_BASE_URL=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar
GOOGLE_CALENDAR_DEFAULT_ID=primary

# ── [OPCIONAL] IA — Sugestão de coleções (IBM watsonx.ai) ────────────────────
# Desligada, o botão de sugestão some (e a rota responde 503).
# Vazio = liga sozinha quando WATSONX_API_KEY e WATSONX_PROJECT_ID existem.
WATSONX_ENABLED=0
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Trocar AI_SUGGESTIONS_MODEL_ID ou AI_SUGGESTIONS_MAX_PROJETOS invalida o cache de sugestoes (input_hash muda).
AI_SUGGESTIONS_MODEL_ID=mistralai/mistral-small-3-1-24b-instruct-2503
AI_SUGGESTIONS_MAX_TOKENS=6000
AI_SUGGESTIONS_MAX_PROJETOS=200

# ── [OPCIONAL] SIORG-RJ (estrutura organizacional) ───────────────────────────
# Sincronização manual pela tela de admin de órgãos.
# Vazio = liga sozinha quando SIORG_API_KEY existe.
SIORG_ENABLED=0
# Base da API pública do SIORG (sem barra final).
SIORG_BASE_URL=http://localhost:5000
# Token do ApiConsumer criado no SIORG para o ProjetosRJ.
SIORG_API_KEY=
SIORG_TIMEOUT_SECONDS=10
# Código da unidade raiz do escopo sincronizado (2 = SETD).
SIORG_RAIZ_CODIGO=2

# ── [OPCIONAL] Chatbot ───────────────────────────────────────────────────────
CHATBOT_ENABLED=0
CHATBOT_BASE_URL=
CHATBOT_PORTAL_API_KEY=

# ── [OPCIONAL] Convites por projeto ──────────────────────────────────────────
# Liga a gestão de convites por projeto (modal Compartilhar + rotas de membros).
# Manter off até a curadoria de papéis; aceita 1/true/yes/on.
CONVITES_HABILITADOS=0

# ══ PRODUÇÃO / PRODUCTION ════════════════════════════════════════════════════

# ── Proxy reverso / ProxyFix (Werkzeug) ──────────────────────────────────────
# Só ligar quando a app roda atrás de um proxy que REESCREVE os X-Forwarded-*
# (cliente não consegue forjá-los). Com 0/vazio o comportamento é o de hoje:
# scheme/Host vêm da conexão direta e os headers são ignorados.
# DEPLOY: validar em staging atrás do proxy real antes de produção.
PROXYFIX_ENABLED=0
# Nº de proxies confiáveis por header (0 = ignorar o header). Com um único
# proxy na frente, 1 é o valor correto; contar saltos a mais permite spoof.
PROXYFIX_X_FOR=1
PROXYFIX_X_PROTO=1
# X_HOST=1 exige que o proxy SETE X-Forwarded-Host explicitamente (nginx padrão
# NÃO seta e repassa o do cliente => spoof de Host). Sem essa garantia use 0 e
# defina GOVBR_OIDC_REDIRECT_URI_FIXED.
PROXYFIX_X_HOST=1
PROXYFIX_X_PORT=0
PROXYFIX_X_PREFIX=0

# ── Rate limiting (Flask-Limiter) ────────────────────────────────────────────
# Padrão: memory:// (não persiste). Em produção use, ex.: redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# ── Verificação de schema no boot ────────────────────────────────────────────
# O boot só VERIFICA alembic_version == head e aborta se divergir (nunca migra).
# SKIP_SCHEMA_CHECK=1: pula a verificação — SÓ emergência (banco em correção).
SKIP_SCHEMA_CHECK=
# SKIP_STARTUP_DB_INIT=true: usado pelos scripts de backfill que importam o app
# durante uma migração em andamento; não usar no serviço web.
SKIP_STARTUP_DB_INIT=
