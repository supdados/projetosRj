{% block content %}
<div class="main-container">
    <!-- Cabeçalho simples -->
    <div class="projects-header">
        <h1>Meus Projetos</h1>
        <button type="button" class="btn btn-add-project" data-bs-toggle="modal" data-bs-target="#addProjectModal">
            <i class="fas fa-plus me-1"></i>Novo Projeto
        </button>
    </div>

    <!-- Barra de busca e filtros -->
    <div class="search-filter-bar">
        <span class="projects-title">Todos os Projetos</span>
        <div class="controls-wrapper">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Buscar projeto..." id="searchProject">
            </div>
            <form method="GET" action="{{ url_for('main.list_projects') }}" class="filter-form">
                <select class="filter-select" name="prioridade" id="filterPrioridade">
                    <option value="">Todas as prioridades</option>
                    {% for prio in priorities %}
                        <option value="{{ prio }}" {% if prio == selected_priority %}selected{% endif %}>{{ prio | capitalize }}</option>
                    {% endfor %}
                </select>
                <select class="filter-select" name="status" id="filterStatus">
                    <option value="">Todos os status</option>
                    {% for status in statuses %}
                        <option value="{{ status }}" {% if status == selected_status %}selected{% endif %}>{{ status }}</option>
                    {% endfor %}
                </select>
                {% if is_admin_user %}
                <select class="filter-select" name="area" id="filterArea">
                    <option value="">Todas as áreas</option>
                    {% for area in areas %}
                        <option value="{{ area }}" {% if area == selected_area %}selected{% endif %}>{{ area }}</option>
                    {% endfor %}
                </select>
                {% endif %}
                <select class="filter-select" name="atraso" id="filterAtraso">
                    <option value="">Todos os prazos</option>
                    {% for atraso_val, atraso_text in atrasos_options %}
                        <option value="{{ atraso_val }}" {% if atraso_val == selected_atraso %}selected{% endif %}>{{ atraso_text }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="filter-btn">Filtrar</button>
            </form>
        </div>
    </div>

    <!-- Tabela de projetos -->
    {% if projects %}
        <!-- Toggle para alternar entre visualizações em mobile -->
        <div class="view-toggle px-3">
            <button type="button" class="btn btn-sm view-table active" data-view="table">
                <i class="fas fa-table"></i> Tabela
            </button>
            <button type="button" class="btn btn-sm view-cards" data-view="cards">
                <i class="fas fa-th-large"></i> Cards
            </button>
        </div>
        
        <div class="projects-table-container px-3">
            <!-- Visualização de tabela (padrão para desktop) -->
            <div class="table-scroll">
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th style="width: 3%;">#</th>
                            <th style="width: 20%;">Título</th>
                            <th style="width: 12%;">Área</th>
                            <th style="width: 12%;">Órgão</th>
                            <th style="width: 8%;">Prioridade</th>
                            <th style="width: 8%;">Status</th>
                            <th style="width: 10%;">Data Início</th>
                            <th style="width: 10%;">Data Fim</th>
                            <th style="width: 8%;" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for project in projects %}
                            <tr>
                                <td>{{ project.id }}</td>
                                <td>
                                    <a href="{{ url_for('main.project_detail', project_id=project.id) }}" class="project-title">
                                        {{ project.titulo }}
                                    </a>
                                </td>
                                <td>{{ project.area_responsavel if project.area_responsavel else '-' }}</td>
                                <td>{{ project.orgao if project.orgao else '-' }}</td>
                                <td>
                                    <span class="badge priority-{{ project.prioridade | lower }}">
                                        {{ project.prioridade | capitalize }}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge status-{{ project.status | lower }}">
                                        {{ project.status }}
                                    </span>
                                </td>
                                <td class="date-cell">{{ project.data_inicio_projeto.strftime('%d/%m/%Y') if project.data_inicio_projeto else '-' }}</td>
                                <td class="date-cell">{{ project.data_fim_projeto.strftime('%d/%m/%Y') if project.data_fim_projeto else '-' }}</td>
                                <td class="actions-cell">
                                    <div class="actions-cell-content">
                                        <a href="{{ url_for('main.project_detail', project_id=project.id) }}" class="btn action-btn" title="Ver Detalhes">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        {% if is_admin_user or (current_user_obj and current_user_obj.has_access_to_area(project.area_responsavel)) %}
                                        <a href="{{ url_for('main.edit_project', project_id=project.id) }}" class="btn action-btn" title="Editar Projeto">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form action="{{ url_for('main.delete_project', project_id=project.id) }}" method="post" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja excluir este projeto e todas as suas etapas?');">
                                            <button type="submit" class="btn action-btn delete-btn" title="Excluir Projeto">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <!-- Visualização em cards para dispositivos móveis -->
            <div class="mobile-projects-view px-3">
                {% for project in projects %}
                    <div class="project-card">
                        <div class="project-card-header">
                            <div class="d-flex align-items-center">
                                <span class="project-card-number">{{ project.id }}</span>
                                <a href="{{ url_for('main.project_detail', project_id=project.id) }}" class="project-card-title">
                                    {{ project.titulo }}
                                </a>
                            </div>
                        </div>
                        
                        <div class="project-card-badges">
                            <span class="badge priority-{{ project.prioridade | lower }}">{{ project.prioridade | capitalize }}</span>
                            <span class="badge status-{{ project.status | lower }}">{{ project.status }}</span>
                        </div>
                        
                        <div class="project-card-details">
                            {% if project.area_responsavel %}
                            <span class="project-card-detail">
                                <i class="fas fa-users"></i>{{ project.area_responsavel }}
                            </span>
                            {% endif %}
                            
                            {% if project.orgao %}
                            <span class="project-card-detail">
                                <i class="fas fa-building"></i>{{ project.orgao }}
                            </span>
                            {% endif %}
                        </div>
                        
                        <div class="project-card-date-group">
                            <span class="project-card-detail">
                                <i class="far fa-calendar-alt"></i>Início: {{ project.data_inicio_projeto.strftime('%d/%m/%Y') if project.data_inicio_projeto else '-' }}
                            </span>
                            <span class="project-card-detail">
                                <i class="far fa-calendar-check"></i>Fim: {{ project.data_fim_projeto.strftime('%d/%m/%Y') if project.data_fim_projeto else '-' }}
                            </span>
                        </div>
                        
                        <div class="project-card-actions">
                            <a href="{{ url_for('main.project_detail', project_id=project.id) }}" class="btn btn-sm btn-outline-primary py-0 px-2 me-1" title="Ver Detalhes">
                                <i class="fas fa-eye"></i>Ver
                            </a>
                            {% if is_admin_user or (current_user_obj and current_user_obj.has_access_to_area(project.area_responsavel)) %}
                            <a href="{{ url_for('main.edit_project', project_id=project.id) }}" class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" title="Editar Projeto">
                                <i class="fas fa-edit"></i>Editar
                            </a>
                            <form action="{{ url_for('main.delete_project', project_id=project.id) }}" method="post" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este projeto e todas as suas etapas? Esta ação não pode ser desfeita.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>Excluir
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-folder-open"></i>
            <h4>Nenhum projeto encontrado</h4>
            <p>Os filtros aplicados não retornaram resultados. Tente outros filtros ou crie um novo projeto.</p>
            <button type="button" class="btn btn-create-project" data-bs-toggle="modal" data-bs-target="#addProjectModal">
                <i class="fas fa-plus me-1"></i>Criar Projeto
            </button>
        </div>
    {% endif %}
</div>

{% include "project_add_form.html" %}

{% endblock %}

{% block scripts %}
{{ super() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Lógica de busca e toggle de visualização ---
        const searchInput = document.getElementById('searchProject');
        if (searchInput) {
            searchInput.addEventListener('keyup', function() {
                const searchText = this.value.toLowerCase();
                
                // Filtrar tabela
                document.querySelectorAll('.projects-table tbody tr').forEach(row => {
                    const rowText = row.textContent.toLowerCase();
                    row.style.display = rowText.includes(searchText) ? '' : 'none';
                });
                
                // Filtrar cards
                document.querySelectorAll('.mobile-projects-view .project-card').forEach(card => {
                    const cardText = card.textContent.toLowerCase();
                    card.style.display = cardText.includes(searchText) ? '' : 'none';
                });
            });
        }
        
        const viewTableBtn = document.querySelector('.view-toggle .view-table');
        const viewCardsBtn = document.querySelector('.view-toggle .view-cards');
        const tableContainer = document.querySelector('.table-scroll');
        const cardsContainer = document.querySelector('.mobile-projects-view');
        
        if (viewTableBtn && viewCardsBtn && tableContainer && cardsContainer) {
            viewTableBtn.addEventListener('click', () => {
                tableContainer.style.display = 'block';
                cardsContainer.style.display = 'none';
                viewTableBtn.classList.add('active');
                viewCardsBtn.classList.remove('active');
            });
            
            viewCardsBtn.addEventListener('click', () => {
                tableContainer.style.display = 'none';
                cardsContainer.style.display = 'block';
                viewTableBtn.classList.remove('active');
                viewCardsBtn.classList.add('active');
            });

            if (window.innerWidth < 768) {
                viewCardsBtn.click();
            }
        }

        // --- Lógica do Modal de Adicionar Projeto (Incluída via arquivo separado) ---
    });
</script>
{% include "project_add_form_js.html" %}
{% endblock %} 
