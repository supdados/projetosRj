{
    "name": "projetosrj-spa",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && node scripts/inject-csp-nonce.js && node scripts/emit-routes-manifest.js",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest run"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "2.61.1",
        "@sveltejs/vite-plugin-svelte": "4.0.4",
        "@types/node": "25.9.1",
        "autoprefixer": "10.5.0",
        "postcss": "8.5.15",
        "svelte": "5.56.1",
        "svelte-check": "4.5.0",
        "tailwindcss": "3.4.19",
        "typescript": "5.9.3",
        "vite": "5.4.21",
        "vitest": "3.2.7"
    }
}
